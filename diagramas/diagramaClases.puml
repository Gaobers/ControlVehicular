@startuml

' =========================================================
' CONFIGURACION GENERAL
' =========================================================

left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 10
skinparam linetype ortho
skinparam classAttributeIconSize 0

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #334155
    ArrowColor #475569
    FontColor #0F172A
    FontSize 12
    AttributeFontSize 11
}

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #94A3B8
    FontColor #0F172A
}

skinparam enum {
    BackgroundColor #F1F5F9
    BorderColor #64748B
    FontColor #0F172A
}

hide empty members


' =========================================================
' USUARIOS Y VEHICULOS
' =========================================================

package "Usuarios y Vehiculos" {

    class Usuario {
        - id: Long
        - nombreCompleto: String
        - correo: String
        - contrasena: String
        - telefono: String
        - rol: RolUsuario
        - estado: EstadoUsuario
        - fechaRegistro: LocalDateTime
        --
        + obtenerTodos(): List<Usuario>
        + obtenerPorId(id: Long): Optional<Usuario>
        + guardar(u: Usuario): Usuario
        + eliminar(id: Long): void
        + obtenerTodosPaginados(pageable: Pageable): Page<Usuario>
        + buscarPorNombreOCorreo(valor: String): List<Usuario>
        + cambiarContrasena(nuevaContrasena: String): boolean
        + activar(): void
        + desactivar(): void
        + validarAcceso(): boolean
    }


    class Vehiculo {
        - id: Long
        - propietario: Usuario
        - marca: String
        - modelo: String
        - anio: Integer
        - placa: String
        - color: String
        - kilometrajeActual: Double
        - vin: String
        - motor: String
        - estado: EstadoVehiculo
        - fechaRegistro: LocalDateTime
        --
        + obtenerTodos(): List<Vehiculo>
        + obtenerPorId(id: Long): Optional<Vehiculo>
        + guardar(v: Vehiculo): Vehiculo
        + eliminar(id: Long): void
        + obtenerTodosPaginados(pageable: Pageable): Page<Vehiculo>
        + buscarPorPlaca(placa: String): Optional<Vehiculo>
        + obtenerPorPropietario(idUsuario: Long): List<Vehiculo>
        + actualizarKilometraje(km: Double): void
        + archivar(): void
        + reactivar(): void
        + validarPlaca(): boolean
    }


    class RegistroKilometraje {
        - id: Long
        - vehiculo: Vehiculo
        - kilometraje: Double
        - fechaHora: LocalDateTime
        - activo: boolean
        --
        + obtenerTodos(): List<RegistroKilometraje>
        + obtenerPorId(id: Long): Optional<RegistroKilometraje>
        + guardar(r: RegistroKilometraje): RegistroKilometraje
        + eliminar(id: Long): void
        + obtenerPorVehiculo(idVehiculo: Long): List<RegistroKilometraje>
        + obtenerUltimoRegistro(idVehiculo: Long): Optional<RegistroKilometraje>
        + validarKilometrajeAnterior(): boolean
        + activar(): void
        + desactivar(): void
    }


    class DocumentoVehiculo {
        - id: Long
        - vehiculo: Vehiculo
        - tipo: TipoDocumento
        - descripcion: String
        - numeroDocumento: String
        - fechaVencimiento: LocalDate
        - fechaActualizacion: LocalDateTime
        --
        + obtenerTodos(): List<DocumentoVehiculo>
        + obtenerPorId(id: Long): Optional<DocumentoVehiculo>
        + guardar(d: DocumentoVehiculo): DocumentoVehiculo
        + eliminar(id: Long): void
        + obtenerPorVehiculo(idVehiculo: Long): List<DocumentoVehiculo>
        + verificarVencimiento(): boolean
        + verificarProximidad(): boolean
    }
}


' =========================================================
' MANTENIMIENTOS Y ALERTAS
' =========================================================

package "Mantenimientos y Alertas" {

    class Mantenimiento {
        - id: Long
        - vehiculo: Vehiculo
        - servicio: String
        - observaciones: String
        - fechaObjetivo: LocalDate
        - kilometrajeObjetivo: Double
        - estado: EstadoMantenimiento
        - activo: boolean
        - fechaCreacion: LocalDateTime
        - fechaRealizacion: LocalDate
        - kilometrajeRealizacion: Double
        --
        + obtenerTodos(): List<Mantenimiento>
        + obtenerPorId(id: Long): Optional<Mantenimiento>
        + guardar(m: Mantenimiento): Mantenimiento
        + eliminar(id: Long): void
        + obtenerTodosPaginados(pageable: Pageable): Page<Mantenimiento>
        + obtenerPorVehiculo(idVehiculo: Long): List<Mantenimiento>
        + filtrarPorEstado(estado: EstadoMantenimiento): List<Mantenimiento>
        + calcularEstado(): EstadoMantenimiento
        + marcarComoRealizado(fecha: LocalDate, kilometraje: Double): void
        + reprogramar(fecha: LocalDate, kilometraje: Double): void
        + activar(): void
        + desactivar(): void
    }


    class ReprogramacionMantenimiento {
        - id: Long
        - mantenimiento: Mantenimiento
        - fechaObjetivoAnterior: LocalDate
        - kilometrajeObjetivoAnterior: Double
        - fechaObjetivoNueva: LocalDate
        - kilometrajeObjetivoNuevo: Double
        - fechaReprogramacion: LocalDateTime
        --
        + obtenerTodos(): List<ReprogramacionMantenimiento>
        + obtenerPorId(id: Long): Optional<ReprogramacionMantenimiento>
        + guardar(r: ReprogramacionMantenimiento): ReprogramacionMantenimiento
        + obtenerPorMantenimiento(idMantenimiento: Long): List<ReprogramacionMantenimiento>
    }


    class RecurrenciaMantenimiento {
        - id: Long
        - mantenimiento: Mantenimiento
        - tipo: TipoRecurrencia
        - intervaloMeses: Integer
        - intervaloKilometros: Double
        - activa: boolean
        --
        + obtenerTodos(): List<RecurrenciaMantenimiento>
        + obtenerPorId(id: Long): Optional<RecurrenciaMantenimiento>
        + guardar(r: RecurrenciaMantenimiento): RecurrenciaMantenimiento
        + eliminar(id: Long): void
        + calcularSiguienteFecha(fechaBase: LocalDate): LocalDate
        + calcularSiguienteKilometraje(kmBase: Double): Double
        + activar(): void
        + desactivar(): void
    }


    class RecordatorioMantenimiento {
        - id: Long
        - mantenimiento: Mantenimiento
        - diasAnticipacion: Integer
        - kilometrosAnticipacion: Double
        - activo: boolean
        --
        + obtenerTodos(): List<RecordatorioMantenimiento>
        + obtenerPorId(id: Long): Optional<RecordatorioMantenimiento>
        + guardar(r: RecordatorioMantenimiento): RecordatorioMantenimiento
        + eliminar(id: Long): void
        + verificarPorFecha(fechaActual: LocalDate): boolean
        + verificarPorKilometraje(kmActual: Double): boolean
        + activar(): void
        + desactivar(): void
    }


    class Alerta {
        - id: Long
        - usuario: Usuario
        - mantenimiento: Mantenimiento
        - documento: DocumentoVehiculo
        - tipo: TipoAlerta
        - motivo: String
        - fechaGenerada: LocalDateTime
        - leida: boolean
        --
        + obtenerTodos(): List<Alerta>
        + obtenerPorId(id: Long): Optional<Alerta>
        + guardar(a: Alerta): Alerta
        + eliminar(id: Long): void
        + obtenerPorUsuario(idUsuario: Long): List<Alerta>
        + obtenerNoLeidas(idUsuario: Long): List<Alerta>
        + marcarComoLeida(): void
        + enviarNotificacion(): boolean
    }


    class ProyeccionMantenimiento {
        - id: Long
        - mantenimiento: Mantenimiento
        - promedioKmDia: Double
        - kilometrosRestantes: Double
        - diasEstimados: Integer
        - fechaEstimada: LocalDate
        - fechaCalculo: LocalDateTime
        --
        + obtenerPorMantenimiento(idMantenimiento: Long): Optional<ProyeccionMantenimiento>
        + calcularPromedioKmDia(): Double
        + calcularKilometrosRestantes(): Double
        + calcularDiasEstimados(): Integer
        + calcularFechaEstimada(): LocalDate
        + recalcular(): ProyeccionMantenimiento
    }
}


' =========================================================
' GASTOS Y REPORTES
' =========================================================

package "Gastos y Reportes" {

    class Gasto {
        - id: Long
        - vehiculo: Vehiculo
        - categoria: String
        - monto: BigDecimal
        - fecha: LocalDate
        - descripcion: String
        - fechaRegistro: LocalDateTime
        - activo: boolean
        --
        + obtenerTodos(): List<Gasto>
        + obtenerPorId(id: Long): Optional<Gasto>
        + guardar(g: Gasto): Gasto
        + eliminar(id: Long): void
        + obtenerTodosPaginados(pageable: Pageable): Page<Gasto>
        + obtenerPorVehiculo(idVehiculo: Long): List<Gasto>
        + filtrarPorPeriodo(fechaInicio: LocalDate, fechaFin: LocalDate): List<Gasto>
        + filtrarPorCategoria(categoria: String): List<Gasto>
        + calcularTotal(): BigDecimal
        + validarMonto(): boolean
        + activar(): void
        + desactivar(): void
    }


    class ComprobanteGasto {
        - id: Long
        - gasto: Gasto
        - nombreArchivo: String
        - tipoArchivo: String
        - rutaArchivo: String
        - fechaAdjunto: LocalDateTime
        --
        + obtenerTodos(): List<ComprobanteGasto>
        + obtenerPorId(id: Long): Optional<ComprobanteGasto>
        + guardar(c: ComprobanteGasto): ComprobanteGasto
        + eliminar(id: Long): void
        + obtenerPorGasto(idGasto: Long): Optional<ComprobanteGasto>
        + validarArchivo(): boolean
        + descargar(): void
        + compartir(): void
    }


    class ReporteGasto {
        - id: Long
        - usuario: Usuario
        - fechaInicio: LocalDate
        - fechaFin: LocalDate
        - total: BigDecimal
        - fechaGeneracion: LocalDateTime
        - rutaArchivo: String
        --
        + obtenerTodos(): List<ReporteGasto>
        + obtenerPorId(id: Long): Optional<ReporteGasto>
        + generar(fechaInicio: LocalDate, fechaFin: LocalDate): ReporteGasto
        + calcularTotal(): BigDecimal
        + generarPDF(): void
        + descargar(): void
        + compartir(): void
    }
}


' =========================================================
' ENUMERACIONES
' =========================================================

package "Enumeraciones" {

    enum RolUsuario {
        CLIENTE
        ADMINISTRADOR
    }

    enum EstadoUsuario {
        ACTIVO
        DESACTIVADO
    }

    enum EstadoVehiculo {
        ACTIVO
        ARCHIVADO
    }

    enum EstadoMantenimiento {
        PENDIENTE
        PROXIMO
        VENCIDO
        REALIZADO
    }

    enum TipoRecurrencia {
        TIEMPO
        KILOMETRAJE
        AMBOS
    }

    enum TipoDocumento {
        SEGURO
        REVISION_TECNICA
        OTRO
    }

    enum TipoAlerta {
        MANTENIMIENTO_PROXIMO
        MANTENIMIENTO_VENCIDO
        DOCUMENTO_PROXIMO
        DOCUMENTO_VENCIDO
    }
}


' =========================================================
' RELACIONES PRINCIPALES
' =========================================================

Usuario "1" -- "0..*" Vehiculo : posee >

Vehiculo "1" -- "0..*" RegistroKilometraje : registra >
Vehiculo "1" -- "0..*" DocumentoVehiculo : posee >
Vehiculo "1" -- "0..*" Mantenimiento : posee >
Vehiculo "1" -- "0..*" Gasto : genera >

Mantenimiento "1" -- "0..*" ReprogramacionMantenimiento : conserva historial >
Mantenimiento "1" -- "0..1" RecurrenciaMantenimiento : configura >
Mantenimiento "1" -- "0..1" RecordatorioMantenimiento : configura >
Mantenimiento "0..1" -- "0..*" Alerta : origina >
Mantenimiento "1" -- "0..1" ProyeccionMantenimiento : proyecta >

Usuario "1" -- "0..*" Alerta : recibe >

DocumentoVehiculo "0..1" -- "0..*" Alerta : origina >

Gasto "1" -- "0..1" ComprobanteGasto : adjunta >

Usuario "1" -- "0..*" ReporteGasto : genera >


' =========================================================
' RELACIONES CON ENUMS
' =========================================================

Usuario ..> RolUsuario : rol
Usuario ..> EstadoUsuario : estado

Vehiculo ..> EstadoVehiculo : estado

DocumentoVehiculo ..> TipoDocumento : tipo

Mantenimiento ..> EstadoMantenimiento : estado

RecurrenciaMantenimiento ..> TipoRecurrencia : tipo

Alerta ..> TipoAlerta : tipo


' =========================================================
' ORDEN VISUAL
' =========================================================

' Columna Usuarios / Vehiculos
Usuario -[hidden]down- Vehiculo
Vehiculo -[hidden]down- RegistroKilometraje
RegistroKilometraje -[hidden]down- DocumentoVehiculo

' Columna Mantenimientos
Mantenimiento -[hidden]down- ReprogramacionMantenimiento
ReprogramacionMantenimiento -[hidden]down- RecurrenciaMantenimiento
RecurrenciaMantenimiento -[hidden]down- RecordatorioMantenimiento
RecordatorioMantenimiento -[hidden]down- Alerta
Alerta -[hidden]down- ProyeccionMantenimiento

' Columna Gastos
Gasto -[hidden]down- ComprobanteGasto
ComprobanteGasto -[hidden]down- ReporteGasto

' Columna de Enumeraciones
RolUsuario -[hidden]down- EstadoUsuario
EstadoUsuario -[hidden]down- EstadoVehiculo
EstadoVehiculo -[hidden]down- EstadoMantenimiento
EstadoMantenimiento -[hidden]down- TipoRecurrencia
TipoRecurrencia -[hidden]down- TipoDocumento
TipoDocumento -[hidden]down- TipoAlerta

' Separacion horizontal de los grandes grupos
Usuario -[hidden]right- Mantenimiento
Mantenimiento -[hidden]right- Gasto
Gasto -[hidden]right- RolUsuario


' =========================================================
' NOTAS IMPORTANTES
' =========================================================

note bottom of Usuario
El usuario puede tener rol
CLIENTE o ADMINISTRADOR.

Solo el Cliente actua como
propietario de vehiculos.
end note

note bottom of Alerta
Una alerta puede originarse por un
mantenimiento o por un documento.

mantenimiento y documento son
opcionales individualmente, pero
al menos uno debe estar asociado.
end note

note bottom of Mantenimiento
fechaObjetivo y kilometrajeObjetivo
pueden utilizarse individualmente
o en conjunto.

fechaRealizacion y kilometrajeRealizacion
permanecen vacios hasta que el
mantenimiento sea realizado.

La eliminacion es logica:
eliminar/desactivar cambia activo=false.
No se borra el registro fisicamente.
end note

note bottom of ReprogramacionMantenimiento
Cada reprogramacion conserva los
valores anteriores y los nuevos
para mantener el historial.
end note

note bottom of RegistroKilometraje
La eliminacion es logica:
eliminar/desactivar cambia activo=false.
No se borra el registro fisicamente.
end note

note bottom of Gasto
La eliminacion es logica:
eliminar/desactivar cambia activo=false.
No se borra el registro fisicamente.
end note

note bottom of RecordatorioMantenimiento
La eliminacion es logica:
eliminar/desactivar cambia activo=false.
No se borra el registro fisicamente.
end note

note bottom of Vehiculo
La eliminacion es logica mediante
EstadoVehiculo.ARCHIVADO.
reactivar() restaura el estado ACTIVO.
end note

@enduml
