/* ------------------------------------------------------------
   Vista general de vehículos
   ------------------------------------------------------------ */

CREATE OR REPLACE VIEW vw_vehiculos_detalle AS
SELECT
    v.id,
    v.marca,
    v.modelo,
    v.anio,
    v.placa,
    v.color,
    v.kilometraje_actual,
    v.vin,
    v.motor,
    v.estado,

    u.id AS propietario_id,
    u.nombre_completo AS propietario,
    u.correo AS propietario_correo

FROM vehiculo v

INNER JOIN usuario u
    ON u.id = v.propietario_id;



/* ------------------------------------------------------------
   Vista resumen de mantenimientos
   ------------------------------------------------------------ */

CREATE OR REPLACE VIEW vw_mantenimientos_resumen AS
SELECT
    m.id AS mantenimiento_id,

    v.id AS vehiculo_id,
    v.placa,
    v.marca,
    v.modelo,
    v.kilometraje_actual,

    m.servicio,
    m.fecha_objetivo,
    m.kilometraje_objetivo,
    m.estado,

    CASE
        WHEN m.kilometraje_objetivo IS NOT NULL
        THEN m.kilometraje_objetivo - v.kilometraje_actual
        ELSE NULL
    END AS kilometros_restantes,

    CASE
        WHEN m.fecha_objetivo IS NOT NULL
        THEN DATEDIFF(
            m.fecha_objetivo,
            CURRENT_DATE
        )
        ELSE NULL
    END AS dias_restantes

FROM mantenimiento m

INNER JOIN vehiculo v
    ON v.id = m.vehiculo_id;



/* ------------------------------------------------------------
   Vista completa de gastos
   ------------------------------------------------------------ */

CREATE OR REPLACE VIEW vw_gastos_detalle AS
SELECT
    g.id AS gasto_id,

    g.fecha,
    g.monto,
    g.moneda,
    g.descripcion,
    g.numero_comprobante,
    g.proveedor,

    c.id AS categoria_id,
    c.nombre AS categoria,

    v.id AS vehiculo_id,
    v.placa,
    v.marca,
    v.modelo,

    u.id AS propietario_id,
    u.nombre_completo AS propietario

FROM gasto g

INNER JOIN categoria_gasto c
    ON c.id = g.categoria_id

INNER JOIN vehiculo v
    ON v.id = g.vehiculo_id

INNER JOIN usuario u
    ON u.id = v.propietario_id;



/* ------------------------------------------------------------
   Vista de estadísticas por categoría
   ------------------------------------------------------------ */

CREATE OR REPLACE VIEW vw_gastos_por_categoria AS
SELECT
    g.vehiculo_id,
    c.id AS categoria_id,
    c.nombre AS categoria,

    COUNT(*) AS cantidad_gastos,

    SUM(g.monto) AS total_gastado

FROM gasto g

INNER JOIN categoria_gasto c
    ON c.id = g.categoria_id

GROUP BY
    g.vehiculo_id,
    c.id,
    c.nombre;



/* ------------------------------------------------------------
   Vista de estadísticas por vehículo
   ------------------------------------------------------------ */

CREATE OR REPLACE VIEW vw_gastos_por_vehiculo AS
SELECT
    v.id AS vehiculo_id,
    v.placa,
    v.marca,
    v.modelo,

    COUNT(g.id) AS cantidad_gastos,

    COALESCE(
        SUM(g.monto),
        0
    ) AS total_gastado

FROM vehiculo v

LEFT JOIN gasto g
    ON g.vehiculo_id = v.id

GROUP BY
    v.id,
    v.placa,
    v.marca,
    v.modelo;



