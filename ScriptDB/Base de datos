/* ============================================================
   1. USUARIOS
   ============================================================ */

CREATE TABLE usuario (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,

    nombre_completo VARCHAR(120) NOT NULL,
    correo VARCHAR(190) NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    telefono VARCHAR(30) NULL,

    rol ENUM(
        'CLIENTE',
        'ADMINISTRADOR'
    ) NOT NULL DEFAULT 'CLIENTE',

    estado ENUM(
        'ACTIVO',
        'DESACTIVADO'
    ) NOT NULL DEFAULT 'ACTIVO',

    email_verificado_at DATETIME NULL,
    ultimo_acceso_at DATETIME NULL,

    fecha_registro DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    fecha_actualizacion DATETIME NOT NULL
        DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    CONSTRAINT uq_usuario_correo
        UNIQUE (correo)
);

CREATE INDEX idx_usuario_nombre
    ON usuario(nombre_completo);

CREATE INDEX idx_usuario_rol
    ON usuario(rol);

CREATE INDEX idx_usuario_estado
    ON usuario(estado);



/* ============================================================
   2. SESIONES DEL USUARIO
   Soporte para seguridad y sesiones activas
   ============================================================ */

CREATE TABLE sesion_usuario (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,

    usuario_id BIGINT UNSIGNED NOT NULL,

    token_hash VARCHAR(255) NOT NULL,

    dispositivo VARCHAR(150) NULL,
    sistema_operativo VARCHAR(100) NULL,
    ip VARCHAR(45) NULL,

    fecha_inicio DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    ultimo_acceso DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,

    fecha_expiracion DATETIME NOT NULL,
    fecha_cierre DATETIME NULL,

    activa BOOLEAN NOT NULL DEFAULT TRUE,

    CONSTRAINT uq_sesion_token
        UNIQUE (token_hash),

    CONSTRAINT fk_sesion_usuario
        FOREIGN KEY (usuario_id)
        REFERENCES usuario(id)
        ON UPDATE CASCADE
        ON DELETE CASCADE
);

CREATE INDEX idx_sesion_usuario
    ON sesion_usuario(usuario_id);

CREATE INDEX idx_sesion_activa
    ON sesion_usuario(activa);



/* ============================================================
   3. RECUPERACION DE CONTRASEÑA
   ============================================================ */

CREATE TABLE token_recuperacion_password (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,

    usuario_id BIGINT UNSIGNED NOT NULL,

    token_hash VARCHAR(255) NOT NULL,

    fecha_creacion DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    fecha_expiracion DATETIME NOT NULL,
    fecha_uso DATETIME NULL,

    utilizado BOOLEAN NOT NULL DEFAULT FALSE,

    CONSTRAINT uq_recuperacion_token
        UNIQUE (token_hash),

    CONSTRAINT fk_recuperacion_usuario
        FOREIGN KEY (usuario_id)
        REFERENCES usuario(id)
        ON UPDATE CASCADE
        ON DELETE CASCADE
);

CREATE INDEX idx_recuperacion_usuario
    ON token_recuperacion_password(usuario_id);



/* ============================================================
   4. VEHICULOS
   ============================================================ */

CREATE TABLE vehiculo (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,

    propietario_id BIGINT UNSIGNED NOT NULL,

    marca VARCHAR(80) NOT NULL,
    modelo VARCHAR(100) NOT NULL,

    anio SMALLINT UNSIGNED NOT NULL,

    placa VARCHAR(20) NOT NULL,
    color VARCHAR(60) NULL,

    kilometraje_actual DECIMAL(12,1) NOT NULL DEFAULT 0,

    vin VARCHAR(50) NULL,
    motor VARCHAR(150) NULL,

    estado ENUM(
        'ACTIVO',
        'ARCHIVADO'
    ) NOT NULL DEFAULT 'ACTIVO',

    fecha_registro DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,

    fecha_actualizacion DATETIME NOT NULL
        DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    CONSTRAINT uq_vehiculo_placa
        UNIQUE (placa),

    CONSTRAINT uq_vehiculo_vin
        UNIQUE (vin),

    CONSTRAINT fk_vehiculo_propietario
        FOREIGN KEY (propietario_id)
        REFERENCES usuario(id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT chk_vehiculo_anio
        CHECK (anio BETWEEN 1900 AND 2200),

    CONSTRAINT chk_vehiculo_kilometraje
        CHECK (kilometraje_actual >= 0)
);

CREATE INDEX idx_vehiculo_propietario
    ON vehiculo(propietario_id);

CREATE INDEX idx_vehiculo_marca_modelo
    ON vehiculo(marca, modelo);

CREATE INDEX idx_vehiculo_estado
    ON vehiculo(estado);



/* ============================================================
   5. HISTORIAL DE PROPIETARIOS
   Conserva reasignaciones realizadas por administrador
   ============================================================ */

CREATE TABLE historial_propietario_vehiculo (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,

    vehiculo_id BIGINT UNSIGNED NOT NULL,
    propietario_id BIGINT UNSIGNED NOT NULL,

    cambiado_por BIGINT UNSIGNED NULL,

    fecha_desde DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    fecha_hasta DATETIME NULL,

    observacion VARCHAR(255) NULL,

    CONSTRAINT fk_historial_prop_vehiculo
        FOREIGN KEY (vehiculo_id)
        REFERENCES vehiculo(id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT fk_historial_prop_usuario
        FOREIGN KEY (propietario_id)
        REFERENCES usuario(id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT fk_historial_prop_admin
        FOREIGN KEY (cambiado_por)
        REFERENCES usuario(id)
        ON UPDATE CASCADE
        ON DELETE SET NULL,

    CONSTRAINT chk_historial_prop_fechas
        CHECK (
            fecha_hasta IS NULL
            OR fecha_hasta >= fecha_desde
        )
);

CREATE INDEX idx_historial_prop_vehiculo
    ON historial_propietario_vehiculo(vehiculo_id);

CREATE INDEX idx_historial_prop_propietario
    ON historial_propietario_vehiculo(propietario_id);



/* ============================================================
   6. HISTORIAL DE KILOMETRAJE
   ============================================================ */

CREATE TABLE registro_kilometraje (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,

    vehiculo_id BIGINT UNSIGNED NOT NULL,
    registrado_por BIGINT UNSIGNED NULL,

    kilometraje DECIMAL(12,1) NOT NULL,

    fecha_hora DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,

    observacion VARCHAR(255) NULL,

    CONSTRAINT fk_kilometraje_vehiculo
        FOREIGN KEY (vehiculo_id)
        REFERENCES vehiculo(id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT fk_kilometraje_usuario
        FOREIGN KEY (registrado_por)
        REFERENCES usuario(id)
        ON UPDATE CASCADE
        ON DELETE SET NULL,

    CONSTRAINT chk_registro_kilometraje
        CHECK (kilometraje >= 0)
);

CREATE INDEX idx_kilometraje_vehiculo_fecha
    ON registro_kilometraje(
        vehiculo_id,
        fecha_hora DESC
    );



/* ============================================================
   7. DOCUMENTACION DEL VEHICULO
   ============================================================ */

CREATE TABLE documento_vehiculo (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,

    vehiculo_id BIGINT UNSIGNED NOT NULL,

    tipo ENUM(
        'SEGURO',
        'REVISION_TECNICA',
        'OTRO'
    ) NOT NULL,

    descripcion VARCHAR(150) NULL,
    numero_documento VARCHAR(100) NULL,

    entidad_emisora VARCHAR(150) NULL,

    fecha_emision DATE NULL,
    fecha_vencimiento DATE NULL,

    activo BOOLEAN NOT NULL DEFAULT TRUE,

    fecha_registro DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,

    fecha_actualizacion DATETIME NOT NULL
        DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    CONSTRAINT fk_documento_vehiculo
        FOREIGN KEY (vehiculo_id)
        REFERENCES vehiculo(id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT chk_documento_fechas
        CHECK (
            fecha_emision IS NULL
            OR fecha_vencimiento IS NULL
            OR fecha_vencimiento >= fecha_emision
        )
);

CREATE INDEX idx_documento_vehiculo
    ON documento_vehiculo(vehiculo_id);

CREATE INDEX idx_documento_tipo
    ON documento_vehiculo(tipo);

CREATE INDEX idx_documento_vencimiento
    ON documento_vehiculo(fecha_vencimiento);



/* ============================================================
   8. MANTENIMIENTOS
   ============================================================ */

CREATE TABLE mantenimiento (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,

    vehiculo_id BIGINT UNSIGNED NOT NULL,
    creado_por BIGINT UNSIGNED NULL,

    /* Sirve para enlazar mantenimientos recurrentes */
    mantenimiento_origen_id BIGINT UNSIGNED NULL,

    servicio VARCHAR(150) NOT NULL,
    observaciones TEXT NULL,

    fecha_objetivo DATE NULL,
    kilometraje_objetivo DECIMAL(12,1) NULL,

    estado ENUM(
        'PENDIENTE',
        'PROXIMO',
        'VENCIDO',
        'REALIZADO'
    ) NOT NULL DEFAULT 'PENDIENTE',

    fecha_realizacion DATE NULL,
    kilometraje_realizacion DECIMAL(12,1) NULL,

    fecha_creacion DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,

    fecha_actualizacion DATETIME NOT NULL
        DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    CONSTRAINT fk_mantenimiento_vehiculo
        FOREIGN KEY (vehiculo_id)
        REFERENCES vehiculo(id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT fk_mantenimiento_usuario
        FOREIGN KEY (creado_por)
        REFERENCES usuario(id)
        ON UPDATE CASCADE
        ON DELETE SET NULL,

    CONSTRAINT fk_mantenimiento_origen
        FOREIGN KEY (mantenimiento_origen_id)
        REFERENCES mantenimiento(id)
        ON UPDATE CASCADE
        ON DELETE SET NULL,

    CONSTRAINT chk_mantenimiento_objetivo
        CHECK (
            fecha_objetivo IS NOT NULL
            OR kilometraje_objetivo IS NOT NULL
        ),

    CONSTRAINT chk_mantenimiento_km_objetivo
        CHECK (
            kilometraje_objetivo IS NULL
            OR kilometraje_objetivo >= 0
        ),

    CONSTRAINT chk_mantenimiento_km_realizacion
        CHECK (
            kilometraje_realizacion IS NULL
            OR kilometraje_realizacion >= 0
        )
);

CREATE INDEX idx_mantenimiento_vehiculo
    ON mantenimiento(vehiculo_id);

CREATE INDEX idx_mantenimiento_estado
    ON mantenimiento(estado);

CREATE INDEX idx_mantenimiento_fecha
    ON mantenimiento(fecha_objetivo);

CREATE INDEX idx_mantenimiento_km
    ON mantenimiento(kilometraje_objetivo);

CREATE INDEX idx_mantenimiento_vehiculo_estado
    ON mantenimiento(vehiculo_id, estado);



/* ============================================================
   9. RECURRENCIA DE MANTENIMIENTO
   Relacion 1 : 0..1
   ============================================================ */

CREATE TABLE recurrencia_mantenimiento (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,

    mantenimiento_id BIGINT UNSIGNED NOT NULL,

    tipo ENUM(
        'TIEMPO',
        'KILOMETRAJE',
        'AMBOS'
    ) NOT NULL,

    intervalo_meses INT UNSIGNED NULL,
    intervalo_kilometros DECIMAL(12,1) NULL,

    activa BOOLEAN NOT NULL DEFAULT TRUE,

    fecha_creacion DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,

    fecha_actualizacion DATETIME NOT NULL
        DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    CONSTRAINT uq_recurrencia_mantenimiento
        UNIQUE (mantenimiento_id),

    CONSTRAINT fk_recurrencia_mantenimiento
        FOREIGN KEY (mantenimiento_id)
        REFERENCES mantenimiento(id)
        ON UPDATE CASCADE
        ON DELETE CASCADE,

    CONSTRAINT chk_recurrencia_intervalos
        CHECK (
            (
                tipo = 'TIEMPO'
                AND intervalo_meses IS NOT NULL
                AND intervalo_meses > 0
            )
            OR
            (
                tipo = 'KILOMETRAJE'
                AND intervalo_kilometros IS NOT NULL
                AND intervalo_kilometros > 0
            )
            OR
            (
                tipo = 'AMBOS'
                AND intervalo_meses IS NOT NULL
                AND intervalo_meses > 0
                AND intervalo_kilometros IS NOT NULL
                AND intervalo_kilometros > 0
            )
        )
);



/* ============================================================
   10. RECORDATORIOS DE MANTENIMIENTO
   ============================================================ */

CREATE TABLE recordatorio_mantenimiento (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,

    mantenimiento_id BIGINT UNSIGNED NOT NULL,

    dias_anticipacion INT UNSIGNED NULL DEFAULT 15,
    kilometros_anticipacion DECIMAL(12,1) NULL DEFAULT 500,

    activo BOOLEAN NOT NULL DEFAULT TRUE,

    fecha_creacion DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,

    fecha_actualizacion DATETIME NOT NULL
        DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    CONSTRAINT uq_recordatorio_mantenimiento
        UNIQUE (mantenimiento_id),

    CONSTRAINT fk_recordatorio_mantenimiento
        FOREIGN KEY (mantenimiento_id)
        REFERENCES mantenimiento(id)
        ON UPDATE CASCADE
        ON DELETE CASCADE,

    CONSTRAINT chk_recordatorio_valores
        CHECK (
            (
                dias_anticipacion IS NOT NULL
                AND dias_anticipacion >= 0
            )
            OR
            (
                kilometros_anticipacion IS NOT NULL
                AND kilometros_anticipacion >= 0
            )
        )
);



/* ============================================================
   11. HISTORIAL DE REPROGRAMACIONES
