/* ============================================================
   TRIGGERS
   ============================================================ */

DELIMITER $$


/* ------------------------------------------------------------
   Impedir registrar un kilometraje inferior al actual
   ------------------------------------------------------------ */

CREATE TRIGGER trg_registro_kilometraje_before_insert
BEFORE INSERT ON registro_kilometraje
FOR EACH ROW
BEGIN

    DECLARE v_kilometraje_actual DECIMAL(12,1);

    SELECT kilometraje_actual
    INTO v_kilometraje_actual
    FROM vehiculo
    WHERE id = NEW.vehiculo_id;

    IF v_kilometraje_actual IS NULL THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'El vehículo indicado no existe.';
    END IF;

    IF NEW.kilometraje < v_kilometraje_actual THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT =
            'El kilometraje no puede ser menor al kilometraje actual del vehículo.';
    END IF;

END$$



/* ------------------------------------------------------------
   Actualizar kilometraje actual del vehículo
   al registrar una nueva lectura
   ------------------------------------------------------------ */

CREATE TRIGGER trg_registro_kilometraje_after_insert
AFTER INSERT ON registro_kilometraje
FOR EACH ROW
BEGIN

    UPDATE vehiculo
    SET kilometraje_actual = NEW.kilometraje
    WHERE id = NEW.vehiculo_id;

END$$



/* ------------------------------------------------------------
   Validar origen y tipo de alerta al insertar
   ------------------------------------------------------------ */

CREATE TRIGGER trg_alerta_before_insert
BEFORE INSERT ON alerta
FOR EACH ROW
BEGIN

    /* Debe existir exactamente un origen */
    IF (
        NEW.mantenimiento_id IS NULL
        AND NEW.documento_id IS NULL
    )
    OR (
        NEW.mantenimiento_id IS NOT NULL
        AND NEW.documento_id IS NOT NULL
    ) THEN

        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT =
            'La alerta debe estar asociada a un mantenimiento o a un documento, pero no a ambos.';

    END IF;

    /* Validar que el tipo coincida con el origen */
    IF NEW.mantenimiento_id IS NOT NULL
       AND NEW.tipo NOT IN (
           'MANTENIMIENTO_PROXIMO',
           'MANTENIMIENTO_VENCIDO'
       ) THEN

        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT =
            'El tipo de alerta no corresponde a un mantenimiento.';

    END IF;

    IF NEW.documento_id IS NOT NULL
       AND NEW.tipo NOT IN (
           'DOCUMENTO_PROXIMO',
           'DOCUMENTO_VENCIDO'
       ) THEN

        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT =
            'El tipo de alerta no corresponde a un documento.';

    END IF;

END$$


/* ------------------------------------------------------------
   Validar alerta al actualizar y marcar fecha de lectura
   ------------------------------------------------------------ */

CREATE TRIGGER trg_alerta_before_update
BEFORE UPDATE ON alerta
FOR EACH ROW
BEGIN

    /* Debe existir exactamente un origen */
    IF (
        NEW.mantenimiento_id IS NULL
        AND NEW.documento_id IS NULL
    )
    OR (
        NEW.mantenimiento_id IS NOT NULL
        AND NEW.documento_id IS NOT NULL
    ) THEN

        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT =
            'La alerta debe estar asociada a un mantenimiento o a un documento, pero no a ambos.';

    END IF;

    /* Validar que el tipo coincida con el origen */
    IF NEW.mantenimiento_id IS NOT NULL
       AND NEW.tipo NOT IN (
           'MANTENIMIENTO_PROXIMO',
           'MANTENIMIENTO_VENCIDO'
       ) THEN

        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT =
            'El tipo de alerta no corresponde a un mantenimiento.';

    END IF;

    IF NEW.documento_id IS NOT NULL
       AND NEW.tipo NOT IN (
           'DOCUMENTO_PROXIMO',
           'DOCUMENTO_VENCIDO'
       ) THEN

        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT =
            'El tipo de alerta no corresponde a un documento.';

    END IF;

    /* Registrar automáticamente cuándo pasa de no leída a leída */
    IF NEW.leida = TRUE
       AND OLD.leida = FALSE
       AND NEW.fecha_lectura IS NULL THEN

        SET NEW.fecha_lectura = CURRENT_TIMESTAMP;

    END IF;

    /* Si vuelve a marcarse como no leída, limpiar la fecha */
    IF NEW.leida = FALSE
       AND OLD.leida = TRUE THEN

        SET NEW.fecha_lectura = NULL;

    END IF;

END$$


